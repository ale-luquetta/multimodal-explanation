  "polarized_reviews": [
    {
      "rank": 0,
      "embedding_idx": 13,
      "text": "The best daily prayer app ever. It impacted my prayer life positively. I love this app"
    },
    {
      "rank": 1,
      "embedding_idx": 19,
      "text": "This app is the best prayer app that I have seen, the app is a nice app u can try it out. It helps you to align with your prayer app it was even someone that told me about this app and I love it,I would recommend it for anyone, this app deserve a five star"
    },
    {
      "rank": 2,
      "embedding_idx": 6,
      "text": "I'm rating it five stars because it is a good app. a app with morning and evening prayer guidelines, and also scriptures to be memorized everyday. I really do love it. That's why I'm giving it 5. ⭐"
    },
    {
      "rank": 3,
      "embedding_idx": 15,
      "text": "I've been looking for an app to support my prayer life. This is a beautiful app that met my need. I enjoy reading the verses, quotes, devotional and prayers each morning and evening. The natural imagery in the photography is beautiful and even the way the app opens with the fragmented colours that change into the clearer images is so calming and beautiful. It completely draws me in. Great app."
    },
    {
      "rank": 4,
      "embedding_idx": 2,
      "text": "I love these morning and evening prayers and devotions. They are reflective, not too long, not too short, but perfectly reflective. I like the 4 choices everyday of morning prayer, verse, evening prayer, etc. The screen is not overwhelming. Very simple to follow and responsive. You can save favorites. Perfect for any faith."
    }
